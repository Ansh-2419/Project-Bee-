{
    "format_version": "1.8.0",
    "render_controllers": {
      "controller.render.my_bee": {
        "arrays": {
            "textures": {
              "array.skins": [
                "texture.default",
                "texture.nectar",
                "texture.angry",
                "texture.angry_nectar"
              ]
            }
        },
        "geometry": "Geometry.default",
        "materials": [ { "*": "Material.default" } ],
        "textures": [ "array.skins[query.property('utilitycraft:has_nectar') ? query.is_angry ? 3 : 1 : query.is_angry ? 2 : 0]" ]
      }
    }
  }