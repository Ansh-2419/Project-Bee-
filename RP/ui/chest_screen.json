{
    "namespace": "chest",

    "small_chest_screen": {
        "$temp_container_title|default": "$container_title",

        "modifications": [
            {
                "array_name": "variables",
                "operation": "insert_back",
                "value": [
                    {
                        "requires": "($temp_container_title = 'projectbee.advance_beehive.ui')",
                        "$screen_content": "advance_beehive.utility_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'projectbee.advance_beehive_expanded.ui')",
                        "$screen_content": "advance_beehive_extended.utility_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'entity.utilitycraft:powered_centrifuge.name')",
                        "$screen_content": "powered_centrifuge.utility_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'projectbee.feeding_slab.ui')",
                        "$screen_content": "feeding_slab.utility_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'projectbee.feeding_slab_double.ui')",
                        "$screen_content": "feeding_slab_double.utility_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'projectbee.breeding_chamber.ui')",
                        "$screen_content": "breeding_chamber.utility_panel",
                        "$screen_bg_content": "common.screen_background"
                    }
                ]
            }
        ]
    }
}
