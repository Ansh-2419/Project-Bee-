{
  "namespace": "powered_centrifuge",

  "powered_centrifuge_top": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [220, 120],
    "offset": [-10, -40],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "$right_machine_tabs_name|default": "right_machine_tabs",
    "$info_toggle_control_name|default": "info_toggle_button",
    "controls": [
      { "machine_name@uc.machine_name": {} },
      { "panel@uc.machine_side_panel": { "offset": [-2, 0] } },

      {
        "screen": {
          "type": "image",
          "texture": "textures/ui/background/background_panel",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [250, 176],
          "offset": [20, 40],
          "layer": -1
        }
      },

      {
        "input_slot@large_input_slot": {
          "anchor_from": "center",
          "anchor_to": "center",
          "collection_index": 3,
          "offset": [-76, 0],
          "layer": 1
        }
      },

      {
        "energy_bar@uc.big_energy_bar": {
          "$has_bg": false,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 8]
        }
      },

      {
        "progress_arrow@uc.progress_display": {
          "collection_index": 2,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 32],
          "size": [26, 20]
        }
      },

      {
        "output_grid_bg": {
          "type": "image",
          "texture": "textures/ui/background/slot_group",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [110, 110],
          "offset": [86, 0],
          "layer": 0
        }
      },

      {
        "out_00@large_output_slot": { "collection_index": 4, "offset": [48, -46], "layer": 1 }
      },
      {
        "out_01@large_output_slot": { "collection_index": 5, "offset": [0, -46], "layer": 1 }
      },
      {
        "out_02@large_output_slot": { "collection_index": 6, "offset": [-48, -46], "layer": 1 }
      },

      {
        "out_10@large_output_slot": { "collection_index": 7, "offset": [48, 0], "layer": 1 }
      },
      {
        "out_11@large_output_slot": { "collection_index": 8, "offset": [0, 0], "layer": 1 }
      },
      {
        "out_12@large_output_slot": { "collection_index": 9, "offset": [-48, 0], "layer": 1 }
      },

      {
        "out_20@large_output_slot": { "collection_index": 10, "offset": [48, 46], "layer": 1 }
      },
      {
        "out_21@large_output_slot": { "collection_index": 11, "offset": [0, 46], "layer": 1 }
      },
      {
        "out_22@large_output_slot": { "collection_index": 12, "offset": [-48, 46], "layer": 1 }
      },

      {
        "info_tab@uc.info_tab": {
          "offset": [22, -52],
          "$right_machine_tabs_name": "$right_machine_tabs_name",
          "$info_toggle_control_name": "$info_toggle_control_name",
          "$info_description": "ui.projectbee:info.powered_centrifuge",
          "$info_panel_size": [80, 160]
        }
      },

      {
        "close_button@common.close_button": {
          "size": [12, 12],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [35, -3],
          "layer": 40
        }
      }
    ]
  },

  "utility_panel": {
    "type": "panel",
    "controls": [
      { "machine_top@powered_centrifuge.powered_centrifuge_top": {} }
    ]
  }
} 