{
    "namespace": "how_to_play",

    "how_to_play_selector_stack_panel/how_to_play_selector_pane": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_front",
                "value": [
                    {
                        "padding_pb_00": {
                            "type": "panel",
                            "size": [ 0, 6 ]
                        }
                    },
                    {
                        "pb_category@how_to_play_common.topic_category": {
                            "$category": "project_bee"
                        }
                    },
                    {
                        "pb:introduction_button@how_to_play.pb:introduction_button": {
                            "$toggle_group_forced_index": 501
                        }
                    },
                    {
                        "pb:bees_button@how_to_play.pb:bees_button": {
                            "$toggle_group_forced_index": 502
                        }
                    },
                    {
                        "pb:machines_button@how_to_play.pb:machines_button": {
                            "$toggle_group_forced_index": 503
                        }
                    }
                ]
            }
        ]
    },

    "how_to_play_section_content_panels/general_tips_sections": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_front",
                "value": [
                    {
                        "pb:introduction_section@how_to_play.pb:introduction_section": {}
                    },
                    {
                        "pb:bees_section@how_to_play.pb:bees_section": {}
                    },
                    {
                        "pb:machines_section@how_to_play.pb:machines_section": {}
                    }
                ]
            }
        ]
    },

    "pb_img_machine@how_to_play_common.image": {
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "size": [ "150px", "150px" ]
    },

    "pb:introduction_button@how_to_play_common.section_toggle_button": {
        "$section_topic": "pb:introduction"
    },
    "pb:bees_button@how_to_play_common.section_toggle_button": {
        "$section_topic": "pb:bees"
    },
    "pb:machines_button@how_to_play_common.section_toggle_button": {
        "$section_topic": "pb:machines"
    },

    "pb:introduction_section@how_to_play_common.main_sections": {
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "pb:introduction_button_toggle",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
