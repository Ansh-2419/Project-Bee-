{
  "namespace": "bee_incubator",

  "output_slot": {
    "type": "input_panel",
    "size": [18, 18],
    "controls": [
      { "item@common.container_item": { "$cell_image_size": [18, 18], "layer": 1 } },
      { "slot_bg": { "type": "image", "texture": "textures/ui/slots/bee_output_slot", "size": [18, 18], "layer": 4 } }
    ]
  },

  "incubator_panel": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "size": [162, 72],
    "offset": [-10, -40],
    "$energy_bar_offset|default": [-72, 0],
    "$energy_bar_bg_texture|default": "textures/ui/toggle_button/left_bg",
    "$right_machine_tabs_name|default": "right_machine_tabs",
    "$io_toggle_control_name|default": "io_toggle_button",
    "$io_config_tabs_name|default": "io_config_tabs",
    "$io_items_toggle_control_name|default": "io_items_toggle_button",
    "$info_toggle_control_name|default": "info_toggle_button",
    "controls": [
      { "machine_name@uc.machine_name": { "$offset": [10, 0] } },
      { "panel@uc.machine_side_panel": {} },
      {
        "item_label@uc.text_label": {
          "collection_index": 1,
          "anchor_from": "top_left", "anchor_to": "top_left",
          "size": [74, 140], "$text_scale": 0.55, "offset": [-78, 2]
        }
      },
      {
        "energy_bar@uc.energy_bar": {
          "$has_bg": false,
          "offset": "$energy_bar_offset",
          "$bar_bg_texture": "$energy_bar_bg_texture"
        }
      },
      {
        "progress_arrow@uc.progress_display": {
          "anchor_from": "top_middle", "anchor_to": "top_middle",
          "collection_index": 2,
          "offset": [10, 20]
        }
      },
      {
        "bee_input@uc.input_slot": {
          "anchor_from": "top_middle", "anchor_to": "top_middle",
          "collection_index": 3,
          "offset": [-26, 25],
          "layer": 2
        }
      },
      {
        "bee_input_overlay": {
          "type": "image",
          "texture": "textures/ui/cage_overally",
          "anchor_from": "top_middle", "anchor_to": "top_middle",
          "offset": [-26, 25],
          "size": [16, 16], "layer": 5
        }
      },
      {
        "output@bee_incubator.output_slot": {
          "anchor_from": "top_middle", "anchor_to": "top_middle",
          "collection_index": 4,
          "offset": [40, 25],
          "layer": 2
        }
      },
      {
        "honey_treat@uc.input_slot": {
          "anchor_from": "top_middle", "anchor_to": "top_middle",
          "collection_index": 5,
          "offset": [16, 48],
          "layer": 2
        }
      },
      {
        "io_tab@uc.io_tab": {
          "$right_machine_tabs_name": "$right_machine_tabs_name",
          "$io_toggle_control_name": "$io_toggle_control_name",
          "$io_config_tabs_name": "$io_config_tabs_name",
          "$io_items_toggle_control_name": "$io_items_toggle_control_name",
          "$io_items_modes_description": "ui.projectbee:io.bee_incubator.items",
          "$has_item_io": true, "$has_fluid_io": false, "$io_items_default": true,
          "$io_top_texture":    "textures/blocks/breeding_chamber",
          "$io_left_texture":   "textures/blocks/breeding_chamber",
          "$io_front_texture":  "textures/blocks/breeding_chamber",
          "$io_right_texture":  "textures/blocks/breeding_chamber",
          "$io_bottom_texture": "textures/blocks/breeding_chamber",
          "$io_back_texture":   "textures/blocks/breeding_chamber",
          "$io_item_top_index": 6,  "$io_item_left_index": 7,
          "$io_item_front_index": 8, "$io_item_right_index": 9,
          "$io_item_bottom_index": 10, "$io_item_back_index": 11
        }
      },
      {
        "info_tab@uc.info_tab": {
          "$right_machine_tabs_name": "$right_machine_tabs_name",
          "$info_toggle_control_name": "$info_toggle_control_name",
          "$info_description": "ui.projectbee:info.bee_incubator"
        }
      }
    ]
  },

  "utility_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "flying_item_renderer@common.flying_item_renderer": { "layer": 14 } },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "controls": [
            {
              "chest_panel": {
                "type": "panel", "layer": 5,
                "controls": [{
                  "normal_content": {
                    "type": "panel",
                    "controls": [
                      { "common_panel@common.common_panel": { "$show_close_button": true } },
                      { "incubator_panel@bee_incubator.incubator_panel": {} },
                      { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {} },
                      { "hotbar_grid@common.hotbar_grid_template": {} },
                      { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} }
                    ]
                  }
                }]
              }
            },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  }
}